template vob_button_neutral {
        block "sound" { using = ui_checkbox }
        texture = "gfx/interface/vob/neutral.dds" effectname = "NoHighlight"
        spriteType = Corneredstretched spriteborder = { 5 5 } framesize = { 19 19 }
        gfxtype = togglepushbuttongfx upframe = 1 uphoverframe = 2 uppressedframe = 3
        downframe = 4 downhoverframe = 5 downpressedframe = 5 disableframe = 6 fontsize = 22
    }
template vob_button_positive {
        block "sound" { using = ui_checkbox }
        texture = "gfx/interface/vob/positive.dds" effectname = "NoHighlight"
        spriteType = Corneredstretched spriteborder = { 5 5 } framesize = { 19 19 }
        gfxtype = togglepushbuttongfx upframe = 1 uphoverframe = 2 uppressedframe = 3
        downframe = 4 downhoverframe = 5 downpressedframe = 5 disableframe = 6 fontsize = 22
    }
template vob_button_danger {
        block "sound" { using = ui_checkbox }
        texture = "gfx/interface/vob/danger.dds" effectname = "NoHighlight"
        spriteType = Corneredstretched spriteborder = { 5 5 } framesize = { 19 19 }
        gfxtype = togglepushbuttongfx upframe = 1 uphoverframe = 2 uppressedframe = 3
        downframe = 4 downhoverframe = 5 downpressedframe = 5 disableframe = 6 fontsize = 22
    }
template vob_button_ghost {
        block "sound" { using = ui_checkbox }
        texture = "gfx/interface/vob/ghost.dds" effectname = "NoHighlight"
        spriteType = Corneredstretched spriteborder = { 5 5 } framesize = { 19 19 }
        gfxtype = togglepushbuttongfx upframe = 1 uphoverframe = 2 uppressedframe = 3
        downframe = 4 downhoverframe = 5 downpressedframe = 5 disableframe = 6 fontsize = 22
    }
types vob_types {
type vob_hud = widget {
    name = "vob_hud"
    size = { 100% 100% }
    parentanchor = top|left
    widgetanchor = top|left
    allow_outside = yes
    alwaystransparent = yes
    focuspolicy = none
    focus_on_visible = no
visible = "[And(IsInGame, And(Not(IsPauseMenuShown), Not(IsGameOverScreenShown)))]"
state = {
        name = vob_new_ui_session
        trigger_on_create = yes
        on_start = "[GetVariableSystem.Clear('vob_armed')]"
on_start = "[GetVariableSystem.Clear('vob_panel')]"
on_start = "[GetVariableSystem.Clear('vob_excluded_only')]"
on_start = "[GetVariableSystem.Clear('vob_reply_before')]"
on_start = "[GetVariableSystem.Clear('vob_last_action')]"
on_start = "[GetVariableSystem.Clear('vob_begin_pending')]"
on_start = "[GetVariableSystem.Clear('vob_cleanup_pending')]"
on_start = "[GetVariableSystem.Clear('vob_picker')]"
on_start = "[GetVariableSystem.Clear('vob_filters_collapsed')]"
on_start = "[GetVariableSystem.Set('vob_seen_open', ToString_int32(FixedPointToInt(GetPlayer.MakeScope.Var('vob_open_requested').GetValueWithDefault('(CFixedPoint)0'))))]"
    }
state = {
        name = _hide
        on_start = "[GetVariableSystem.Clear('vob_armed')]"
on_start = "[GetVariableSystem.Clear('vob_panel')]"
on_start = "[GetVariableSystem.Clear('vob_begin_pending')]"
on_start = "[GetVariableSystem.Clear('vob_cleanup_pending')]"
    }

    widget = {
        name = "vob_begin_acknowledged"
        size = { 1 1 }
        alwaystransparent = yes
        state = {
            name = vob_run
            trigger_when = "[And(GetVariableSystem.Exists('vob_begin_pending'), And(And(GetVariableSystem.Exists('vob_reply_before'), Not(GetVariableSystem.HasValue('vob_reply_before', ToString_int32(FixedPointToInt(GetPlayer.MakeScope.Var('vob_ui_reply').GetValueWithDefault('(CFixedPoint)0')))))), EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('vob_phase').GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)1')))]"
            on_start = "[GetVariableSystem.Clear('vob_begin_pending')]"
on_start = "[GetVariableSystem.Clear('vob_panel')]"
on_start = "[GetVariableSystem.Set('vob_armed', 'yes')]"
        }
    }

    widget = {
        name = "vob_begin_empty"
        size = { 1 1 }
        alwaystransparent = yes
        state = {
            name = vob_run
            trigger_when = "[And(GetVariableSystem.Exists('vob_begin_pending'), And(And(GetVariableSystem.Exists('vob_reply_before'), Not(GetVariableSystem.HasValue('vob_reply_before', ToString_int32(FixedPointToInt(GetPlayer.MakeScope.Var('vob_ui_reply').GetValueWithDefault('(CFixedPoint)0')))))), EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('vob_phase').GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)0')))]"
            on_start = "[GetVariableSystem.Clear('vob_begin_pending')]"
        }
    }

    widget = {
        name = "vob_cleanup_acknowledged"
        size = { 1 1 }
        alwaystransparent = yes
        state = {
            name = vob_run
            trigger_when = "[And(GetVariableSystem.Exists('vob_cleanup_pending'), EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('vob_initialized').GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)0'))]"
            on_start = "[GetVariableSystem.Clear('vob_armed')]"
on_start = "[GetVariableSystem.Clear('vob_panel')]"
on_start = "[GetVariableSystem.Clear('vob_cleanup_pending')]"
on_start = "[GetVariableSystem.Clear('vob_seen_open')]"
on_start = "[GetVariableSystem.Clear('vob_reply_before')]"
        }
    }

    widget = {
        name = "vob_batch_finished"
        size = { 1 1 }
        alwaystransparent = yes
        state = {
            name = vob_run
            trigger_when = "[And(GetVariableSystem.Exists('vob_armed'), EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('vob_phase').GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)0'))]"
            on_start = "[GetVariableSystem.Clear('vob_armed')]"
on_start = "[GetVariableSystem.Set('vob_panel', 'yes')]"
on_start = "[GetVariableSystem.Set('vob_tab', 'settings')]"
        }
    }

    widget = {
        name = "vob_open_next"
        size = { 1 1 }
        alwaystransparent = yes
        state = {
            name = vob_run
            trigger_when = "[And(And(GetVariableSystem.Exists('vob_armed'), And(And(IsInGame, And(GetPlayer.IsValid, And(Not(GetMetaPlayer.IsObserver), And(Not(GameIsMultiplayer), And(Not(IsPauseMenuShown), Not(IsGameOverScreenShown)))))), IsGamePaused)), And(EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('vob_phase').GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)1'), And(GetPlayer.MakeScope.Var('vob_target').GetCountry.IsValid, And(GetPlayer.CanSignTreatyWith(GetPlayer.MakeScope.Var('vob_target').GetCountry.Self), IsDataModelEmpty(AccessPlayer.GetDraftTreatiesWith(GetPlayer.MakeScope.Var('vob_target').GetCountry.Self))))))]"
            on_start = "[InformationPanelBar.OpenTreatyDraftPanelForNewDraft(GetPlayer.Self, GetPlayer.MakeScope.Var('vob_target').GetCountry.Self)]"
on_start = "[GetScriptedGui('vob_step_1_2').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
        }
    }

    widget = {
        name = "vob_skip_unavailable_country"
        size = { 1 1 }
        alwaystransparent = yes
        state = {
            name = vob_run
            trigger_when = "[And(And(GetVariableSystem.Exists('vob_armed'), And(And(IsInGame, And(GetPlayer.IsValid, And(Not(GetMetaPlayer.IsObserver), And(Not(GameIsMultiplayer), And(Not(IsPauseMenuShown), Not(IsGameOverScreenShown)))))), IsGamePaused)), And(EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('vob_phase').GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)1'), Not(And(GetPlayer.MakeScope.Var('vob_target').GetCountry.IsValid, And(GetPlayer.CanSignTreatyWith(GetPlayer.MakeScope.Var('vob_target').GetCountry.Self), IsDataModelEmpty(AccessPlayer.GetDraftTreatiesWith(GetPlayer.MakeScope.Var('vob_target').GetCountry.Self)))))))]"
            on_start = "[GetScriptedGui('vob_skip_1').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
        }
    }

    widget = {
        name = "vob_advance_queue"
        size = { 1 1 }
        alwaystransparent = yes
        state = {
            name = vob_run
            trigger_when = "[And(And(GetVariableSystem.Exists('vob_armed'), And(And(IsInGame, And(GetPlayer.IsValid, And(Not(GetMetaPlayer.IsObserver), And(Not(GameIsMultiplayer), And(Not(IsPauseMenuShown), Not(IsGameOverScreenShown)))))), IsGamePaused)), EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('vob_phase').GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)8'))]"
            on_start = "[GetScriptedGui('vob_advance').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
        }
    }

    widget = {
        name = "vob_native_decision_entry"
        size = { 1 1 }
        alwaystransparent = yes
        state = {
            name = vob_run
            trigger_when = "[And(And(IsInGame, And(Not(IsPauseMenuShown), Not(IsGameOverScreenShown))), And(GetPlayer.IsValid, And(Not(EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('vob_open_requested').GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)0')), Not(GetVariableSystem.HasValue('vob_seen_open', ToString_int32(FixedPointToInt(GetPlayer.MakeScope.Var('vob_open_requested').GetValueWithDefault('(CFixedPoint)0'))))))))]"
            on_start = "[GetVariableSystem.Clear('vob_armed')]"
on_start = "[GetVariableSystem.Clear('vob_begin_pending')]"
on_start = "[GetVariableSystem.Clear('vob_cleanup_pending')]"
on_start = "[GetVariableSystem.Clear('vob_reply_before')]"
on_start = "[InformationPanelBar.ClosePanel]"
on_start = "[GetVariableSystem.Set('vob_panel', 'yes')]"
on_start = "[GetVariableSystem.Set('vob_tab', 'settings')]"
on_start = "[GetVariableSystem.Set('vob_region_tab', Select_CString(EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('vob_mode').GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)4'), 'exclude', 'include'))]"
on_start = "[GetVariableSystem.Clear('vob_country_regions')]"
on_start = "[GetVariableSystem.Clear('vob_picker')]"
on_start = "[GetScriptedGui('vob_consume_ui_request').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('language', MakeScopeValue(Select_CFixedPoint(EqualTo_string(Localize('vob_ui_language_token'), 'zh'), '(CFixedPoint)1', '(CFixedPoint)2'))).End)]"
on_start = "[GetVariableSystem.Set('vob_seen_open', ToString_int32(FixedPointToInt(GetPlayer.MakeScope.Var('vob_open_requested').GetValueWithDefault('(CFixedPoint)0'))))]"
        }
    }
widget = {
        name = "vob_running_bar"
        visible = "[GetVariableSystem.Exists('vob_armed')]"
        parentanchor = bottom|hcenter
        widgetanchor = bottom|hcenter
        position = { 0 -80 }
        size = { 940 168 }
        using = clickthrough_blocker
        focuspolicy = none
        focus_on_visible = no
        background = { using = default_background }
        vbox = {
            position = { 15 8 }
            spacing = 3
